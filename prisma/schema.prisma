generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["driverAdapters"]
}

datasource db {
    provider = "postgresql"
}

model Admin {
    id        String   @id @default(cuid())
    email     String   @unique
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Webinar {
    id              String   @id @default(cuid())
    headline        String
    date            String
    time            String
    link            String
    keynoteSpeakers String[]
    moderators      String[]
    chairpersons    String[]
    coChairmen      String[]
    sponsors        Json     @default("[]")
    thumbnail       String   @default("")
    /// Free-text speakers line, styled by speakersStyle (see src/lib/text-style.ts).
    speakers        String   @default("")
    speakersStyle   Json     @default("{}")
    description     String   @default("")
    descriptionStyle Json    @default("{}")
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
}

enum UploadStatus {
    PENDING
    APPROVED
    REJECTED
}

model Video {
    id             String       @id @default(cuid())
    title          String
    link           String
    description    String       @default("")
    tags           String[]
    status         UploadStatus @default(PENDING)
    uploadedById   String?
    uploadedByName String?
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
}

model Photo {
    id             String       @id @default(cuid())
    title          String
    link           String
    description    String       @default("")
    tags           String[]
    status         UploadStatus @default(PENDING)
    uploadedById   String?
    uploadedByName String?
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
}

enum MemberStatus {
    PENDING
    APPROVED
    REJECTED
}

model CasePresentation {
    id          String   @id @default(cuid())
    title       String
    files       String[]
    description String   @default("")
    tags        String[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

enum GuidelineType {
    PATIENT
    CLINICAL
}

model Guideline {
    id        String        @id @default(cuid())
    type      GuidelineType @default(PATIENT)
    title     String
    /// Source: any external URL the admin pasted.
    link      String        @default("")
    /// Uploaded PDF/DOC paths, served through /api/files/.
    pdfs      String[]
    thumbnail String        @default("")
    tags      String[]
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
}

model Member {
    id                     String       @id @default(cuid())
    name                   String
    mobileNo               String
    email                  String       @unique
    password               String?
    bmdcNo                 String
    designation            String
    specialtySubject       String
    otherSpecialty         String?
    academicQualifications String
    specializedTraining    String?
    currentPosting         String?
    pastPostings           String[]
    chamberAddresses       String[]
    shortIntroduction      String?
    shortBiography         String?
    journals               String?
    profilePicture         String?
    backgroundPicture      String?
    interventions          String[]
    status                 MemberStatus @default(PENDING)
    rejectionReason        String?
    createdAt              DateTime     @default(now())
    updatedAt              DateTime     @updatedAt
}
